<html>
  <head>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventarios</title>
    <style>
            {{asset "inventarios-styles.css" "utf8"}}
    </style>
  </head>
  <body>   
    <h1 class="report-title">Listado de inventarios</h1>   

  <!-- ============================================= -->
  <!-- TABLE WITH MANY COLUMNS (Handlebars loop)     -->
  <!-- ============================================= -->
  <div class="table-container">
    <table class="wide-table">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Unidad de Medida</th>
          <th>Cantidad</th>
          <th>Area</th>          
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{product.name}}</td>
          <td>{{product.um.name}}</td>
          <td>{{count}}</td>
          <td>{{area.name}}</td>         
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div> 
</body>
</html>
