<html>
  <head>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type">
    <style>
            {{asset "inventarios-styles.css" "utf8"}}
        </style>
  </head>
  <body>   
        <div class="inventario-box">
            <table cellpadding="0" cellspacing="0">
                <tr class="top">
                    <td colspan="2">
                        <table>
                            <tr>
                                <td class="title">
                                    <span>Listado de inventarios</span>
                                </td>                                
                            </tr>
                        </table>
                    </td>
                </tr>                
                <tr class="heading">
                    <td>
                        Producto
                    </td>
                    <td>
                        UM
                    </td>
                    <td>
                        Cantidad
                    </td>
                    <td>
                        Area
                    </td>
                </tr>
                {{#each items}}
                <tr class="item">
                    <td>
                        {{product.name}}
                    </td>
                    <td>
                        {{product.um.name}}
                    </td>
                    <td>
                        {{count}}
                    </td>
                    <td>
                        {{area.name}}
                    </td>
                </tr>
                {{/each}}                
            </table>
        </div>
  </body>
</html>
