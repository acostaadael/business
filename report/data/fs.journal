{"operation":"update","timestamp":{"$$date":1771519571130},"version":380,"doc":{"name":"entradas-main","engine":"handlebars","recipe":"chrome-pdf","shortid":"2rgTiWRld","chrome":{"printBackground":true},"creationDate":{"$$date":1771518413761},"modificationDate":{"$$date":1771519571124},"_id":"f84vAUlNCaTebZXC","$entitySet":"templates","content":"<html>\r\n  <head>\r\n    <meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Inventarios</title>\r\n    <style>\r\n            {{asset \"entradas-styles.css\" \"utf8\"}}\r\n    </style>\r\n  </head>\r\n  <body>   \r\n    <h1 class=\"report-title\">Entradas de productos {{period}}</h1>   \r\n\r\n  <!-- ============================================= -->\r\n  <!-- TABLE WITH MANY COLUMNS (Handlebars loop)     -->\r\n  <!-- ============================================= -->\r\n  <div class=\"table-container\">\r\n    <table class=\"wide-table\">\r\n      <thead>\r\n        <tr>\r\n          <th>Dia</th>  \r\n          <th>Producto</th>\r\n          <th>Unidad de Medida</th>\r\n          <th>Cantidad</th>\r\n          <th>Area</th>          \r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {{#each items}}\r\n        <tr>\r\n          <td>{{day}}</td>  \r\n          <td>{{product.name}}</td>\r\n          <td>{{product.um.name}}</td>\r\n          <td>{{count}}</td>\r\n          <td>{{area.name}}</td>         \r\n        </tr>\r\n        {{/each}}\r\n      </tbody>\r\n    </table>\r\n  </div> \r\n</body>\r\n</html>\r\n","folder":{"shortid":"kKmMxzj"},"$$etag":1771519571130}}
